{
  "name": "react-ssg",
  "version": "1.0.0",
  "description": "Static Site Generation with React",
  "main": "index.js",
  "scripts": {
    "build:client": "webpack --config webpack.client.config.js",
    "build:ssg": "tsx scripts/build-ssg.ts",
    "build": "rm -rf dist && npm run build:client && npm run build:ssg",
